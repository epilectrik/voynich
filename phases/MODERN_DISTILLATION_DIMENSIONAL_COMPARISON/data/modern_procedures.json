    "_note": "Extended from Brunschwig v2.0 taxonomy. Phases match BRSC 7-phase structure. MIDPROCESS actions are the critical addition -- modern procedures explicitly encode these.",
    "_phase_1_collection": "--- COLLECTION ---",
    "HARVEST": "Harvest plant material at optimal time (bloom stage, morning after dew)",
    "SELECT": "Sort/select best specimens, remove non-oil plant parts",
    "PURCHASE": "Obtain commercial essential oil or plant material",
    "_phase_2_preparation": "--- PREPARATION ---",
    "CUT": "Cut/chop plant material to optimal size (~1 inch / 20mm pieces)",
    "GRIND": "Grind or crush material for increased surface area",
    "DRY": "Dry material (air-dry, shade-dry, oven-dry)",
    "WILT": "Partial wilting for 1-2 days to reduce moisture",
    "WEIGH": "Weigh material for solid/liquid ratio specification",
    "LOAD_STILL": "Load plant material into still/flask on grid/perforated plate",
    "ADD_WATER": "Add water to still to cover or partially cover material",
    "ASSEMBLE": "Assemble distillation apparatus (condenser, receiver, adapters)",
    "PACK_EVEN": "Ensure even packing to prevent channeling",
    "_phase_3_pretreatment": "--- PRETREATMENT ---",
    "MACERATE": "Soak in water/solvent for hours to days before distillation",
    "MIX": "Combine multiple materials or add salt for azeotrope adjustment",
    "_phase_4_distillation": "--- DISTILLATION ---",
    "HEAT": "Apply heat to begin distillation (burner, mantle, steam injection)",
    "GENERATE_STEAM": "Generate steam from water in vessel or external boiler",
    "DISTILL": "Core distillation process (vapors passing through material)",
    "REDISTILL": "Redistill product for higher purity",
    "_phase_5_midprocess": "--- MIDPROCESS (during distillation) ---",
    "MONITOR_TEMP": "Monitor temperature (thermocouple, thermometer, finger test)",
    "MONITOR_RATE": "Monitor distillation rate (drip count, flow rate)",
    "MONITOR_VISUAL": "Visual inspection of distillate (clarity, cloudiness, color)",
    "ADJUST_HEAT": "Increase or decrease heat input based on monitoring",
    "DETECT_CHANNELING": "Check for uneven steam distribution via temperature differential",
    "AGITATE": "Stir or reposition material to correct channeling",
    "COOL_CONDENSER": "Manage condenser cooling water temperature",
    "REPLENISH_WATER": "Add water to still to maintain level during long distillation",
    "DETECT_ENDPOINT": "Determine when to stop (volume plateau, clarity change, time limit)",
    "MANAGE_PRESSURE": "Adjust vacuum or pressure during distillation",
    "COHOBATE": "Return distillate water to still for redistillation",
    "COLLECT_FRACTION": "Switch collection vessel at temperature/time cutpoint",
    "SEAL_JOINTS": "Seal/lute vessel joints during process",
    "_phase_6_postprocess": "--- POSTPROCESS ---",
    "SEPARATE_OIL": "Separate oil from water by density (Florentine flask, pipette)",
    "DRY_OIL": "Remove residual water with drying agent (Na2SO4, MgSO4)",
    "FILTER": "Filter through cloth, paper, or felt",
    "EXTRACT_SOLVENT": "Extract oil into organic solvent from milky distillate",
    "EVAPORATE_SOLVENT": "Remove solvent by rotary evaporation",
    "TEST_QUALITY": "Analyze quality (GC/MS, sensory evaluation, density test)",
    "SETTLE": "Let sediment/emulsion separate over time",
    "_phase_7_storage": "--- STORAGE ---",
    "SEAL_VESSEL": "Seal storage vessel (cap, plug, cork)",
    "LABEL": "Label with contents, date, batch number",
    "STORE_COOL": "Store in cool/dark/airtight conditions",
    "AGE": "Allow still odors to dissipate over weeks of aging"
  },
